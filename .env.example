# Spring maps these environment variables to prediction.service.* properties.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/career_guidance
SPRING_DATASOURCE_USERNAME=career_guidance
SPRING_DATASOURCE_PASSWORD=change-me
APP_SECRET_KEY=change-to-at-least-32-random-characters
PREDICTION_SERVICE_URL=http://127.0.0.1:8000/predict
PREDICTION_SERVICE_CONNECT_TIMEOUT_MS=5000
PREDICTION_SERVICE_READ_TIMEOUT_MS=180000
